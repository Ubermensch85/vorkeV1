# =============================================================================
# Vorke V1 Configuration — Template Variabili d'Ambiente & Credenziali
# =============================================================================
# Copiare questo file in /etc/vorke/vorke.env o esportare le variabili secondo necessità.
# ATTENZIONE: Non committare mai file con credenziali reali nel repository!

# Telegram Bot (per notifiche dns-guardian, monitoraggio e bot diagnostico)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIjkLmNoPqRsTuVwXyZ"
TELEGRAM_CHAT_ID="123456789"

# Transmission Daemon
TRANSMISSION_AUTH="username:password"
TRANSMISSION_HOST="localhost"

# Plex Media Server (per refresh automatico delle librerie su nuovi download)
PLEX_TOKEN="your_plex_token_here"
PLEX_HOST="http://127.0.0.1:32400"

# Pi-hole API
PIHOLE_API_URL="http://127.0.0.1:8080/api/stats/summary"
