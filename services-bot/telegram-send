#!/bin/bash
# =============================================================================
# telegram-send — Script per invio messaggi via Telegram per Vorke
# =============================================================================

# Cerca credenziali nelle consuete posizioni di configurazione protetta
TOKEN="${TELEGRAM_BOT_TOKEN:-}"
CHAT_ID="${TELEGRAM_CHAT_ID:-}"

if [ -z "$TOKEN" ] || [ -z "$CHAT_ID" ]; then
    for conf in "/etc/dns-guardian/telegram.conf" "$HOME/.config/dns-guardian/telegram.conf" "/etc/vorke/telegram.conf"; do
        if [ -f "$conf" ]; then
            # shellcheck source=/dev/null
            source "$conf"
            break
        fi
    done
fi

MESSAGE="$1"

if [ -z "$MESSAGE" ]; then
    echo "Errore: Messaggio vuoto." >&2
    exit 1
fi

if [ -z "${TELEGRAM_BOT_TOKEN:-}" ] || [ -z "${TELEGRAM_CHAT_ID:-}" ]; then
    echo "Errore: Variabili TELEGRAM_BOT_TOKEN o TELEGRAM_CHAT_ID non definite." >&2
    exit 1
fi

curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
    -d chat_id="${TELEGRAM_CHAT_ID}" \
    -d text="$MESSAGE" \
    -d parse_mode="HTML" > /dev/null
